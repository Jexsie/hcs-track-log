# ─── Hedera network ──────────────────────────────────────────────
# testnet | previewnet | mainnet
HEDERA_NETWORK=testnet

# Operator account that pays fees and creates the topic.
HEDERA_OPERATOR_ID=0.0.xxxxxx
# DER- or hex-encoded ECDSA/ED25519 private key. Placeholder — never commit a real key.
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── HCS topic ───────────────────────────────────────────────────
# Filled in after `npm run topic:create`.
HCS_TOPIC_ID=0.0.xxxxxx

# ─── Multi-signature submit key ──────────────────────────────────
# Public keys of every authorized submitter (comma-separated).
HCS_SUBMIT_PUBLIC_KEYS=302a300506032b6570032100xxxxxxxx,302a300506032b6570032100yyyyyyyy
# How many of the keys above must sign each message (1..N).
HCS_SUBMIT_THRESHOLD=2
# Private keys this server signs with (comma-separated). Must satisfy the threshold.
HCS_SUBMIT_SIGNER_KEYS=302e020100300506032b657004220420xxxxxxxx,302e020100300506032b657004220420yyyyyyyy

# ─── Mirror node ─────────────────────────────────────────────────
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ─── Postgres (required) ─────────────────────────────────────────
# Matches docker-compose.yml defaults.
DATABASE_URL=postgres://hcs:hcs@localhost:5432/hcs_track_log
# Used by `npm run test`. Its schema is DROPPED on every run; the name must end in _test.
TEST_DATABASE_URL=postgres://hcs:hcs@localhost:5432/hcs_track_log_test

# ─── Write API ───────────────────────────────────────────────────
# Bearer token required by POST /api/parcels and POST /api/parcels/:parcelHash/events.
# The server co-signs submissions, so without this anyone could write to the topic through it.
# Generate one with: openssl rand -hex 32
SUBMITTER_API_TOKEN=change-me-to-a-long-random-string
