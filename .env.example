# ─── Hedera network ──────────────────────────────────────────────
# testnet | previewnet | mainnet
HEDERA_NETWORK=testnet

# Operator account: pays for topic creation and for approval schedules. It is NOT a submit key.
HEDERA_OPERATOR_ID=0.0.xxxxxx
# DER- or hex-encoded ECDSA/ED25519 private key. Placeholder — never commit a real key.
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── HCS topic ───────────────────────────────────────────────────
# Filled in after `npm run topic:create`.
HCS_TOPIC_ID=0.0.xxxxxx

# ─── Multi-signature submit key ──────────────────────────────────
# Public keys of the administrators' WALLET accounts (comma-separated). Every topic message must be
# approved from these wallets in the admin console; the web server never holds these private keys.
HCS_SUBMIT_PUBLIC_KEYS=302a300506032b6570032100xxxxxxxx,302a300506032b6570032100yyyyyyyy
# How many wallet approvals each message needs (2..N).
HCS_SUBMIT_THRESHOLD=2

# ─── Multi-signature ADMIN key ───────────────────────────────────
# Public keys of topic administrators (comma-separated). Required to create, update or delete the
# topic. The running server needs only these PUBLIC keys, to confirm the topic was not altered.
HCS_ADMIN_PUBLIC_KEYS=302a300506032b6570032100aaaaaaaa,302a300506032b6570032100bbbbbbbb
# How many admin signatures are required (2..N).
HCS_ADMIN_THRESHOLD=2
# Admin private keys, used ONLY by `npm run topic:create`. Remove them from the server afterwards.
HCS_ADMIN_SIGNER_KEYS=302e020100300506032b657004220420aaaaaaaa,302e020100300506032b657004220420bbbbbbbb

# ─── Mirror node ─────────────────────────────────────────────────
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ─── Postgres (required) ─────────────────────────────────────────
# Matches docker-compose.yml defaults.
DATABASE_URL=postgres://hcs:hcs@localhost:5432/hcs_track_log

# ─── Administrator console (wallet approvals) ────────────────────
# WalletConnect Cloud project id from https://dashboard.reown.com (32 hex characters).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# HMAC key for sign-in challenges and admin session cookies. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# How long a proposal waits for wallet approvals, in hours (1..1488; Hedera allows up to 62 days).
HCS_APPROVAL_WINDOW_HOURS=24
